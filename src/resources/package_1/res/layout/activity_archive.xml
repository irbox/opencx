<?xml version='1.0' encoding='utf-8' ?>
<com.alphainventor.filemanager.widget.WindowInsetsFrameLayout android:id="@id/root_view"
                      android:background="?android:attr/colorBackground"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:explorer="http://schemas.android.com/apk/res-auto">
  <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
    <FrameLayout android:id="@id/toolbar_container"
                 android:layout_width="fill_parent"
                 android:layout_height="?attr/actionBarSize"
                 explorer:layout_constraintBottom_toTopOf="@id/fragment_container"
                 explorer:layout_constraintTop_toTopOf="parent" />
    <FrameLayout android:id="@id/fragment_container"
                 android:layout_width="fill_parent"
                 android:layout_height="0.0dp"
                 explorer:layout_constraintBottom_toTopOf="@id/paste_layout"
                 explorer:layout_constraintTop_toBottomOf="@id/toolbar_container" />
    <com.alphainventor.filemanager.widget.BlockTouchView android:id="@id/paste_layout_safe_area"
                          android:visibility="gone"
                          android:layout_width="fill_parent"
                          android:layout_height="@dimen/bottom_menu_safe_area_height"
                          android:importantForAccessibility="no"
                          explorer:layout_constraintBottom_toTopOf="@id/paste_layout" />
    <include android:id="@id/paste_layout"
             android:layout_width="fill_parent"
             android:layout_height="wrap_content"
             explorer:layout_constraintBottom_toTopOf="@id/playback_controls_layout"
             explorer:layout_constraintTop_toBottomOf="@id/fragment_container"
             layout="@layout/list_bottom_menu" />
    <include android:id="@id/playback_controls_layout"
             android:layout_width="fill_parent"
             android:layout_height="wrap_content"
             explorer:layout_constraintBottom_toBottomOf="parent"
             explorer:layout_constraintTop_toBottomOf="@id/paste_layout"
             layout="@layout/playback_controls" />
  </androidx.constraintlayout.widget.ConstraintLayout>
  <View android:id="@id/drag_and_drop_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</com.alphainventor.filemanager.widget.WindowInsetsFrameLayout>