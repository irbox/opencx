<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:id="@id/history_item_root"
                android:background="@drawable/bg_transparent_actionbar_bound"
                android:nextFocusLeft="@id/delete"
                android:nextFocusRight="@id/delete"
                android:descendantFocusability="beforeDescendants"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:explorer="http://schemas.android.com/apk/res-auto">
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="56.0dp">
    <ImageView android:id="@id/icon"
               android:layout_width="56.0dp"
               android:layout_height="fill_parent"
               android:scaleType="center"
               explorer:srcCompat="@drawable/ic_history"
               explorer:tint="@color/actionbar_foreground_color" />
    <TextView android:textSize="16.0sp"
              android:textColor="@color/actionbar_foreground_color"
              android:gravity="center_vertical"
              android:id="@android:id/text1"
              android:paddingLeft="8.0dp"
              android:layout_width="0.0dp"
              android:layout_height="fill_parent"
              android:singleLine="true"
              android:layout_weight="1.0" />
    <ImageButton android:id="@id/delete"
                 android:background="@drawable/bg_transparent_actionbar"
                 android:nextFocusLeft="@id/history_item_root"
                 android:nextFocusRight="@id/history_item_root"
                 android:layout_width="56.0dp"
                 android:layout_height="fill_parent"
                 explorer:srcCompat="@drawable/ic_close"
                 explorer:tint="@color/actionbar_foreground_color" />
  </LinearLayout>
</RelativeLayout>