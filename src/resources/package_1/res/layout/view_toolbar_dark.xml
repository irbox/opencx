<?xml version='1.0' encoding='utf-8' ?>
<com.google.android.material.appbar.MaterialToolbar android:id="@id/toolbar"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent"
                      android:minHeight="?attr/actionBarSize"
                      style="@style/ToolbarStyle.Dark" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:explorer="http://schemas.android.com/apk/res-auto">
  <FrameLayout android:id="@id/title_container"
               android:layout_width="wrap_content"
               android:layout_height="fill_parent">
    <LinearLayout android:layout_gravity="center|start"
                  android:orientation="vertical"
                  android:paddingTop="4.0dp"
                  android:paddingRight="4.0dp"
                  android:paddingBottom="4.0dp"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:paddingEnd="4.0dp">
      <TextView android:textAppearance="@style/ToolbarTitleStyle.Dark"
                android:ellipsize="end"
                android:id="@id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true" />
      <TextView android:textAppearance="@style/ToolbarSubtitleStyle.Dark"
                android:ellipsize="end"
                android:id="@id/subtitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-3.0dp"
                android:singleLine="true" />
    </LinearLayout>
  </FrameLayout>
  <androidx.appcompat.widget.AppCompatImageView android:layout_gravity="start"
                        android:id="@id/arrow_drop_down"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        explorer:srcCompat="@drawable/ic_baseline_arrow_drop_down"
                        explorer:tint="@color/toolbar_dark_foreground" />
  <ProgressBar android:layout_gravity="end"
               android:id="@id/toolbar_progress"
               android:visibility="gone"
               android:layout_width="24.0dp"
               android:layout_height="24.0dp"
               android:layout_marginRight="6.0dp"
               android:indeterminate="true"
               android:layout_marginEnd="6.0dp"
               android:indeterminateTint="@color/toolbar_dark_foreground"
               android:indeterminateTintMode="src_in" />
</com.google.android.material.appbar.MaterialToolbar>