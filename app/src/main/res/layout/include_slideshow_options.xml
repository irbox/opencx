<?xml version='1.0' encoding='utf-8' ?>
<androidx.gridlayout.widget.GridLayout android:id="@id/slideshow_options"
                      android:background="#aa000000"
                      android:padding="16.0dp"
                      android:visibility="gone"
                      android:layout_width="320.0dp"
                      android:layout_height="wrap_content"
                      explorer:alignmentMode="alignBounds"
                      explorer:columnCount="7"
                      explorer:orientation="horizontal"
                      explorer:rowCount="4" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:explorer="http://schemas.android.com/apk/res-auto">
  <ImageView android:layout_width="0.0dp"
             android:scaleType="center"
             explorer:layout_columnWeight="0.75"
             explorer:layout_rowWeight="1.0"
             explorer:srcCompat="@drawable/ic_timer" />
  <Button android:textColor="@color/btn_image_viewer_outlined"
          android:id="@id/interval2"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          android:text="2"
          explorer:backgroundTint="@null"
          explorer:layout_columnSpan="2"
          explorer:layout_columnWeight="1.0"
          explorer:layout_rowWeight="1.0" />
  <Button android:textColor="@color/btn_image_viewer_outlined"
          android:id="@id/interval3"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          android:text="3"
          explorer:backgroundTint="@null"
          explorer:layout_columnSpan="2"
          explorer:layout_columnWeight="1.0"
          explorer:layout_rowWeight="1.0" />
  <Button android:textColor="@color/btn_image_viewer_outlined"
          android:id="@id/interval4"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          android:text="4"
          explorer:backgroundTint="@null"
          explorer:layout_columnSpan="2"
          explorer:layout_columnWeight="1.0"
          explorer:layout_rowWeight="1.0" />
  <Space android:layout_width="0.0dp"
         explorer:layout_columnWeight="0.75"
         explorer:layout_rowWeight="1.0" />
  <Button android:textColor="@color/btn_image_viewer_outlined"
          android:id="@id/interval5"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          android:text="5"
          explorer:backgroundTint="@null"
          explorer:layout_columnSpan="2"
          explorer:layout_columnWeight="1.0"
          explorer:layout_rowWeight="1.0" />
  <Button android:textColor="@color/btn_image_viewer_outlined"
          android:id="@id/interval10"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          android:text="10"
          explorer:backgroundTint="@null"
          explorer:layout_columnSpan="2"
          explorer:layout_columnWeight="1.0"
          explorer:layout_rowWeight="1.0" />
  <Button android:textColor="@color/btn_image_viewer_outlined"
          android:id="@id/interval15"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          android:text="15"
          explorer:backgroundTint="@null"
          explorer:layout_columnSpan="2"
          explorer:layout_columnWeight="1.0"
          explorer:layout_rowWeight="1.0" />
  <ImageView android:layout_width="0.0dp"
             android:scaleType="center"
             explorer:layout_columnWeight="0.75"
             explorer:layout_rowWeight="1.0"
             explorer:srcCompat="@drawable/ic_video" />
  <Button android:id="@id/video_interval"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          explorer:backgroundTint="@null"
          explorer:icon="@drawable/ic_timer_play"
          explorer:iconGravity="textStart"
          explorer:iconPadding="0.0dp"
          explorer:iconTint="@color/btn_image_viewer_outlined"
          explorer:layout_columnSpan="3"
          explorer:layout_columnWeight="1.5"
          explorer:layout_rowWeight="1.0"
          style="@style/Widget.MaterialComponents.Button" />
  <Button android:id="@id/video_full"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          explorer:backgroundTint="@null"
          explorer:icon="@drawable/ic_timer_off"
          explorer:iconGravity="textStart"
          explorer:iconPadding="0.0dp"
          explorer:iconTint="@color/btn_image_viewer_outlined"
          explorer:layout_columnSpan="3"
          explorer:layout_columnWeight="1.5"
          explorer:layout_rowWeight="1.0"
          style="@style/Widget.MaterialComponents.Button" />
  <ImageView android:layout_width="0.0dp"
             android:scaleType="center"
             explorer:layout_columnWeight="0.75"
             explorer:layout_rowWeight="1.0"
             explorer:srcCompat="@drawable/ic_stacks" />
  <Button android:id="@id/toggle_repeat"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          explorer:backgroundTint="@null"
          explorer:icon="@drawable/ic_repeat"
          explorer:iconGravity="textStart"
          explorer:iconPadding="0.0dp"
          explorer:iconTint="@color/btn_image_viewer_outlined"
          explorer:layout_columnSpan="3"
          explorer:layout_columnWeight="1.5"
          explorer:layout_rowWeight="1.0"
          style="@style/Widget.MaterialComponents.Button" />
  <Button android:id="@id/toggle_shuffle"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          explorer:backgroundTint="@null"
          explorer:icon="@drawable/ic_shuffle"
          explorer:iconGravity="textStart"
          explorer:iconPadding="0.0dp"
          explorer:iconTint="@color/btn_image_viewer_outlined"
          explorer:layout_columnSpan="3"
          explorer:layout_columnWeight="1.5"
          explorer:layout_rowWeight="1.0"
          style="@style/Widget.MaterialComponents.Button" />
  <Button android:id="@id/start"
          android:background="@drawable/btn_image_viewer_outlined"
          android:layout_width="0.0dp"
          android:text="@string/btn_start"
          explorer:backgroundTint="@null"
          explorer:layout_columnSpan="7"
          explorer:layout_columnWeight="1.5"
          explorer:layout_rowWeight="1.0"
          style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
</androidx.gridlayout.widget.GridLayout>