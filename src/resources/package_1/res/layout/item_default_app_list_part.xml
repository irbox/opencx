<?xml version='1.0' encoding='utf-8' ?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="6.0dp"
                      android:layout_marginBottom="6.0dp" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:explorer="http://schemas.android.com/apk/res-auto">
  <ImageView android:id="@id/icon"
             android:layout_width="44.0dp"
             android:layout_height="44.0dp"
             explorer:layout_constraintBottom_toBottomOf="parent"
             explorer:layout_constraintStart_toStartOf="parent"
             explorer:layout_constraintTop_toTopOf="parent" />
  <TextView android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@id/activity_name"
            android:fadingEdge="horizontal"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dp"
            android:singleLine="true"
            android:layout_marginStart="8.0dp"
            explorer:layout_constraintBottom_toTopOf="@id/app_name"
            explorer:layout_constraintStart_toEndOf="@id/icon"
            explorer:layout_constraintTop_toTopOf="parent" />
  <TextView android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@id/app_name"
            android:fadingEdge="horizontal"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8.0dp"
            android:singleLine="true"
            android:layout_marginStart="8.0dp"
            explorer:layout_constraintBottom_toBottomOf="parent"
            explorer:layout_constraintStart_toEndOf="@id/icon"
            explorer:layout_constraintTop_toBottomOf="@id/activity_name" />
  <ImageButton android:id="@id/clear"
               android:background="@drawable/bg_transparent"
               android:layout_width="36.0dp"
               android:layout_height="36.0dp"
               android:contentDescription="@string/menu_clear"
               explorer:layout_constraintBottom_toBottomOf="parent"
               explorer:layout_constraintEnd_toEndOf="parent"
               explorer:layout_constraintTop_toTopOf="parent"
               explorer:srcCompat="@drawable/ic_close"
               explorer:tint="@color/red" />
</androidx.constraintlayout.widget.ConstraintLayout>