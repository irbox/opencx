<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:explorer="http://schemas.android.com/apk/res-auto">
  <com.google.android.material.tabs.TabLayout android:id="@id/tab_layout"
                        android:background="@drawable/bg_tablayout_dialog"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        explorer:tabGravity="fill"
                        explorer:tabIconTint="@color/dialog_tab_text"
                        explorer:tabIndicatorHeight="4.0dp"
                        explorer:tabMinWidth="100.0dp"
                        explorer:tabMode="fixed"
                        explorer:tabTextColor="@color/dialog_tab_text" />
  <androidx.viewpager.widget.ViewPager android:id="@id/view_pager"
                        android:layout_width="fill_parent"
                        android:layout_height="250.0dp">
    <ListView android:id="@id/list1"
              android:padding="5.0dp"
              android:clipToPadding="false"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" />
    <ListView android:id="@id/list2"
              android:padding="5.0dp"
              android:clipToPadding="false"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" />
  </androidx.viewpager.widget.ViewPager>
</LinearLayout>