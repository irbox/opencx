<?xml version='1.0' encoding='utf-8' ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@id/root_view"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:explorer="http://schemas.android.com/apk/res-auto">
  <androidx.media3.ui.PlayerView android:id="@id/player_view"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        explorer:bar_gravity="center"
                        explorer:bar_height="2.0dp"
                        explorer:buffered_color="@color/videoplayer_buffered"
                        explorer:controller_layout_id="@layout/video_player_control_view"
                        explorer:played_color="?attr/colorPrimary"
                        explorer:player_layout_id="@layout/video_player_view"
                        explorer:repeat_toggle_modes="one"
                        explorer:scrubber_color="?attr/colorPrimary"
                        explorer:scrubber_dragged_size="18.0dp"
                        explorer:scrubber_enabled_size="14.0dp"
                        explorer:show_buffering="when_playing"
                        explorer:show_shuffle_button="false"
                        explorer:unplayed_color="@color/videoplayer_unplayed" />
  <TextView android:textSize="10.0sp"
            android:id="@id/debug_text_view"
            android:background="#55000088"
            android:paddingLeft="4.0dp"
            android:paddingRight="4.0dp"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100.0dp" />
  <androidx.constraintlayout.widget.ConstraintLayout android:id="@id/ads_overlay"
                        android:visibility="gone"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent">
    <FrameLayout android:id="@id/ads_container"
                 android:background="#ffffff"
                 android:layout_width="300.0dp"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="@dimen/video_ad_marginTop"
                 android:layout_marginBottom="60.0dp"
                 explorer:layout_constraintBottom_toBottomOf="parent"
                 explorer:layout_constraintLeft_toLeftOf="parent"
                 explorer:layout_constraintRight_toRightOf="parent"
                 explorer:layout_constraintTop_toTopOf="parent" />
    <ProgressBar android:id="@id/ads_progress"
                 android:layout_width="60.0dp"
                 android:layout_height="60.0dp"
                 explorer:layout_constraintBottom_toBottomOf="parent"
                 explorer:layout_constraintLeft_toLeftOf="parent"
                 explorer:layout_constraintRight_toRightOf="parent"
                 explorer:layout_constraintTop_toTopOf="parent"
                 style="@style/Widget.AppCompat.ProgressBar" />
    <ImageButton android:id="@id/ads_close"
                 android:background="?attr/selectableItemBackground"
                 android:layout_width="40.0dp"
                 android:layout_height="40.0dp"
                 android:translationX="@dimen/video_ad_close_translate"
                 android:translationY="@dimen/video_ad_close_translate"
                 explorer:layout_constraintLeft_toLeftOf="@id/ads_container"
                 explorer:layout_constraintTop_toTopOf="@id/ads_container"
                 explorer:srcCompat="@drawable/ic_ads_close" />
  </androidx.constraintlayout.widget.ConstraintLayout>
  <RelativeLayout android:id="@id/end_overlay"
                  android:visibility="gone"
                  android:layout_width="fill_parent"
                  android:layout_height="fill_parent" />
  <ProgressBar android:layout_gravity="center"
               android:id="@id/progress"
               android:visibility="gone"
               android:layout_width="60.0dp"
               android:layout_height="60.0dp"
               style="@style/Widget.AppCompat.ProgressBar" />
  <RelativeLayout android:layout_width="fill_parent"
                  android:layout_height="fill_parent">
    <ImageView android:id="@id/icon_splash"
               android:visibility="gone"
               android:layout_width="64.0dp"
               android:layout_height="64.0dp"
               android:shadowColor="#000000"
               android:shadowDx="1.5"
               android:shadowDy="1.3"
               android:shadowRadius="1.6"
               android:layout_centerInParent="true" />
    <TextView android:textSize="48.0sp"
              android:textColor="#ffffff"
              android:id="@id/drag_seek_text"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:shadowColor="#000000"
              android:shadowDx="1.5"
              android:shadowDy="1.3"
              android:shadowRadius="1.6"
              android:layout_centerInParent="true" />
    <TextView android:textStyle="bold"
              android:textColor="#ffffffff"
              android:id="@id/change_speed_playing_indicator"
              android:background="@drawable/bg_player_control_popup"
              android:paddingLeft="10.0dp"
              android:paddingTop="4.0dp"
              android:paddingRight="10.0dp"
              android:paddingBottom="4.0dp"
              android:visibility="invisible"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="2X▶▶"
              android:layout_centerHorizontal="true" />
    <LinearLayout android:orientation="vertical"
                  android:id="@id/drag_control_container"
                  android:background="@drawable/bg_player_control_popup"
                  android:paddingLeft="10.0dp"
                  android:paddingTop="30.0dp"
                  android:paddingRight="10.0dp"
                  android:paddingBottom="14.0dp"
                  android:visibility="gone"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_centerInParent="true">
      <ProgressBar android:layout_gravity="center"
                   android:id="@id/vertical_progressbar"
                   android:layout_width="4.0dp"
                   android:layout_height="100.0dp"
                   style="@style/FileManager.Widget.ProgressBar.Vertical" />
      <ImageView android:layout_gravity="center"
                 android:id="@id/vertical_progressbar_icon"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="14.0dp"
                 explorer:srcCompat="@drawable/ic_player_volume_up" />
    </LinearLayout>
  </RelativeLayout>
  <FrameLayout android:id="@id/fragment_container"
               android:layout_width="fill_parent"
               android:layout_height="fill_parent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>